# Disable directory listing
Options -Indexes

# Force index.html as the default directory index (overrides OVH's index.php)
DirectoryIndex index.html

# Remove OVH default page
<Files "index.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# Enable URL rewriting for React Router (SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Pass Authorization header to PHP (OVH strips it by default)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # ========================================================
  # 🛡️ PROTECTION ANTI-SCRAPING, ANTI-BOTS & MOISSONNEURS IA
  # ========================================================
  # 1. Bloquer les requêtes sans User-Agent (signatures de scripts automatisés)
  RewriteCond %{HTTP_USER_AGENT} ^$
  RewriteRule .* - [F,L]

  # 2. Bloquer les outils, bibliothèques et navigateurs sans tête de scraping
  RewriteCond %{HTTP_USER_AGENT} (python|requests|scrapy|aiohttp|httpx|beautifulsoup|curl|wget|libwww-perl|postman|insomnia|go-http-client) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} (puppeteer|playwright|selenium|phantomjs|headlesschrome|webdriver|casperjs) [NC,OR]
  # 3. Bloquer les robots d'aspiration et crawlers d'IA non autorisés
  RewriteCond %{HTTP_USER_AGENT} (bytespider|diffbot|ccbot|gptbot|chatgpt-user|anthropic-ai|claude-web|perplexitybot|amazonbot|cohere-ai|omgili) [NC]
  RewriteRule .* - [F,L]

  # 4. Interdire le téléchargement direct de fichiers sensibles
  RewriteRule ^.*\.(sql|env|log|md|git|yml|yaml|ini|sh)$ - [F,L]
  
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
